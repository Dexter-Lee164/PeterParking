{
  "name": "university-parking-slot-reservation-system",
  "version": "1.0.0",
  "description": "University Parking — Reserve. Park. Go. Hourly parking slot reservations for a school or university facility (Express + EJS + SQLite).",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:init": "node src/db/cli.js init",
    "db:seed": "node src/db/cli.js seed",
    "db:reset": "node src/db/cli.js reset",
    "db:lots": "node src/db/cli.js lots",
    "check": "node scripts/syntax-check.js",
    "mail:preview": "node scripts/mail-preview.js",
    "db:info": "node scripts/db-info.js",    "test": "node --test --test-concurrency=1 \"tests/*.test.js\""
  },
  "keywords": [
    "parking",
    "reservation",
    "express",
    "ejs",
    "sqlite"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "chart.js": "^4.5.1",
    "dotenv": "^18.0.8",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.1.7"
  }
}
