# better-sqlite3 13 ships prebuilt binaries inside its npm package, so no install-time compilation is needed.
# Without this line, npm (when a lockfile is present) can wrongly try to compile it with node-gyp, which needs a
# C++ toolchain and a download of the Node headers. None of this project's dependencies need install scripts.
# "npm start", "npm test" and "npm run ..." are unaffected by this setting.
ignore-scripts=true
