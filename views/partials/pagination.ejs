<%# Params: pager { page, pages, total, perPage }, baseQuery (object of current filters), noun (optional) %>
<% const base = locals.baseQuery || {}; const noun = locals.noun || 'results'; %>
<div class="pager">
  <span>
    <% if (pager.total === 0) { %>0 <%= noun %>
    <% } else { %>
      Showing <%= (pager.page - 1) * pager.perPage + 1 %>–<%= Math.min(pager.page * pager.perPage, pager.total) %> of <%= pager.total %> <%= noun %>
    <% } %>
  </span>
  <% if (pager.pages > 1) { %>
    <nav aria-label="Pagination">
      <ul class="pagination pagination-sm">
        <li class="page-item <%= pager.hasPrev ? '' : 'disabled' %>">
          <a class="page-link" href="<%= qs(base, { page: pager.page - 1 }) %>" aria-label="Previous page" <%- pager.hasPrev ? '' : 'tabindex="-1" aria-disabled="true"' %>>
            <i class="bi bi-chevron-left" aria-hidden="true"></i>
          </a>
        </li>
        <% for (let p = Math.max(1, pager.page - 2); p <= Math.min(pager.pages, pager.page + 2); p++) { %>
          <li class="page-item <%= p === pager.page ? 'active' : '' %>">
            <a class="page-link" href="<%= qs(base, { page: p }) %>" <%- p === pager.page ? 'aria-current="page"' : '' %>><%= p %></a>
          </li>
        <% } %>
        <li class="page-item <%= pager.hasNext ? '' : 'disabled' %>">
          <a class="page-link" href="<%= qs(base, { page: pager.page + 1 }) %>" aria-label="Next page" <%- pager.hasNext ? '' : 'tabindex="-1" aria-disabled="true"' %>>
            <i class="bi bi-chevron-right" aria-hidden="true"></i>
          </a>
        </li>
      </ul>
    </nav>
  <% } %>
</div>
