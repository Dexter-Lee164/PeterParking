<%# pagination: pg {page,pages,total,from,to}, query (current query object) %>
<% if (pg && pg.total > 0) { %>
<nav class="pager" aria-label="Pagination">
  <span class="pager-info">Showing <%= pg.from %>–<%= pg.to %> of <%= pg.total %></span>
  <% if (pg.pages > 1) { %>
  <ul class="pagination pagination-sm mb-0">
    <li class="page-item <%= pg.page <= 1 ? 'disabled' : '' %>"><a class="page-link" href="<%= h.qs(query || {}, { page: pg.page - 1 }) || '?' %>" <%- pg.page <= 1 ? 'tabindex="-1" aria-disabled="true"' : '' %>>Previous</a></li>
    <li class="page-item disabled"><span class="page-link">Page <%= pg.page %> of <%= pg.pages %></span></li>
    <li class="page-item <%= pg.page >= pg.pages ? 'disabled' : '' %>"><a class="page-link" href="<%= h.qs(query || {}, { page: pg.page + 1 }) %>" <%- pg.page >= pg.pages ? 'tabindex="-1" aria-disabled="true"' : '' %>>Next</a></li>
  </ul>
  <% } %>
</nav>
<% } %>
