<% const fresh = isUnread('payment', row.id); %>
<tr class="<%= fresh ? 'is-unread' : '' %>">
  <td data-label="Receipt"><span class="font-mono fw-semibold"><%= row.receipt_no %></span><% if (fresh) { %><span class="new-pill">New</span><% } %></td>
  <td data-label="Booking"><a class="font-mono" href="/driver/reservations/<%= row.reservation_id %>"><%= row.booking_ref %></a></td>
  <td data-label="Paid on"><%= fmtDateTime(row.paid_at) %></td>
  <td data-label="Method"><%= paymentMethod(row.method) %><% if (row.reference) { %><span class="sub">Ref: <%= row.reference %></span><% } %></td>
  <td data-label="Amount" class="text-end"><%= peso(row.amount_centavos) %></td>
  <td data-label="Status"><%- include('partials/status-badge', { kind: 'payment', status: row.status }) %></td>
  <td data-label="" class="text-end"><a class="btn btn-sm btn-outline-secondary" href="/driver/payments/<%= row.id %>/receipt">Receipt</a></td>
</tr>
