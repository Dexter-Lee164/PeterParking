<% const fresh = isUnread('etiquette_report', row.id); %>
<tr class="<%= fresh ? 'is-unread' : '' %>">
  <td data-label="Report"><span class="font-mono fw-semibold">#<%= row.id %></span><% if (fresh) { %><span class="new-pill">New</span><% } %><span class="sub"><%= fmtDateTime(row.created_at) %></span></td>
  <td data-label="Plate">
    <a class="plate" href="/admin/reports/plate/<%= encodeURIComponent(row.plate_key) %>"><%= row.plate_number %></a>
    <span class="sub"><%= row.plate_report_count %> report<%= row.plate_report_count === 1 ? '' : 's' %><% if (row.plate_active_penalties) { %> · <span class="text-danger"><%= row.plate_active_penalties %> active penalt<%= row.plate_active_penalties === 1 ? 'y' : 'ies' %></span><% } %></span>
  </td>
  <td data-label="Violation"><%= row.violation_label %><% if (row.has_evidence) { %> <i class="bi bi-image text-muted" title="Image attached" aria-label="Image attached"></i><% } %></td>
  <td data-label="Incident"><%= fmtDateTime(row.incident_at) %></td>
  <td data-label="Reported by"><%= row.reporter_name %><span class="sub"><%= row.reporter_email %></span></td>
  <td data-label="Severity"><% if (row.severity) { %><%- include('partials/status-badge', { kind: 'severity', status: row.severity }) %><% } else { %><span class="text-faint">—</span><% } %></td>
  <td data-label="Status"><%- include('partials/status-badge', { kind: 'report', status: row.status }) %></td>
</tr>
