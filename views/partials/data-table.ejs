<%#
  data-table: columns [{label, key?, render?(row)=>html, cls?}], rows, caption?, empty? {title,text,icon,action}, pg?, query?
  render() output is raw HTML, so use h.esc() for any user-supplied text.
%>
<% if (!rows.length) { %>
  <%- include('./empty-state', Object.assign({ title: 'Nothing here yet' }, typeof empty !== 'undefined' ? empty : {})) %>
<% } else { %>
  <div class="table-wrap">
    <table class="table data-table align-middle">
      <% if (typeof caption !== 'undefined') { %><caption class="visually-hidden"><%= caption %></caption><% } %>
      <thead><tr><% columns.forEach(function (c) { %><th scope="col" class="<%= c.cls || '' %>"><%= c.label %></th><% }) %></tr></thead>
      <tbody>
        <% rows.forEach(function (row) { %>
          <tr>
            <% columns.forEach(function (c) { %>
              <td data-label="<%= c.label %>" class="<%= c.cls || '' %>"><% if (c.render) { %><%- c.render(row) %><% } else { %><%= row[c.key] == null || row[c.key] === '' ? '—' : row[c.key] %><% } %></td>
            <% }) %>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% if (typeof pg !== 'undefined' && pg) { %><%- include('./pagination', { pg: pg, query: typeof query !== 'undefined' ? query : {} }) %><% } %>
<% } %>
