<%#
  form-field: name, label, type? (text|email|password|number|date|select|textarea|checkbox), options? [{value,label}], required?, help?,
  placeholder?, attrs? (raw string), cls? (column class), value? (overrides old[name]), errs? (overrides errors)
%>
<%
  const _type = typeof type !== 'undefined' ? type : 'text';
  const _errs = typeof errs !== 'undefined' ? errs : (typeof errors !== 'undefined' ? errors : {});
  const _old = typeof old !== 'undefined' ? old : {};
  const _val = typeof value !== 'undefined' ? value : (_old[name] == null ? '' : _old[name]);
  const _err = _errs[name]; const _id = 'f-' + name;
  const _desc = [(typeof help !== 'undefined' && help) ? _id + '-help' : '', _err ? _id + '-err' : ''].filter(Boolean).join(' ');
  const _attrs = (typeof attrs !== 'undefined' ? attrs : '') + (_desc ? ' aria-describedby="' + _desc + '"' : '') + (_err ? ' aria-invalid="true"' : '') + ((typeof required !== 'undefined' && required) ? ' required' : '');
%>
<div class="form-field <%= typeof cls !== 'undefined' ? cls : '' %>">
  <% if (_type === 'checkbox') { %>
    <div class="form-check form-switch">
      <input class="form-check-input <%= _err ? 'is-invalid' : '' %>" type="checkbox" role="switch" id="<%= _id %>" name="<%= name %>" value="1" <%= (_val === '1' || _val === 1 || _val === true) ? 'checked' : '' %> <%- _attrs %>>
      <label class="form-check-label" for="<%= _id %>"><%= label %></label>
    </div>
  <% } else { %>
    <label class="form-label" for="<%= _id %>"><%= label %><% if (typeof required !== 'undefined' && required) { %><span class="req" aria-hidden="true"> *</span><% } %></label>
    <% if (_type === 'select') { %>
      <select class="form-select <%= _err ? 'is-invalid' : '' %>" id="<%= _id %>" name="<%= name %>" <%- _attrs %>>
        <% options.forEach(function (o) { %><option value="<%= o.value %>" <%= String(o.value) === String(_val) ? 'selected' : '' %>><%= o.label %></option><% }) %>
      </select>
    <% } else if (_type === 'textarea') { %>
      <textarea class="form-control <%= _err ? 'is-invalid' : '' %>" id="<%= _id %>" name="<%= name %>" rows="3" <% if (typeof placeholder !== 'undefined') { %>placeholder="<%= placeholder %>"<% } %> <%- _attrs %>><%= _val %></textarea>
    <% } else { %>
      <input class="form-control <%= _err ? 'is-invalid' : '' %>" type="<%= _type %>" id="<%= _id %>" name="<%= name %>" value="<%= _type === 'password' ? '' : _val %>" <% if (typeof placeholder !== 'undefined') { %>placeholder="<%= placeholder %>"<% } %> <%- _attrs %>>
    <% } %>
  <% } %>
  <% if (typeof help !== 'undefined' && help) { %><div class="form-text" id="<%= _id %>-help"><%= help %></div><% } %>
  <% if (_err) { %><div class="invalid-feedback d-block" id="<%= _id %>-err"><%= _err %></div><% } %>
</div>
