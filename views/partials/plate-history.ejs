<%# Everything known about a plate (admin). Params: history (etiquette.plateHistory), currentReportId (optional). %>
<section class="summary-card mb-3">
  <div class="summary-head">
    <h3>Plate <span class="plate ms-1"><%= history.plate %></span></h3>
    <% if (history.ban) { %>
      <span class="badge-status tone-red"><i class="bi bi-slash-circle-fill" aria-hidden="true"></i><%= history.ban.kind === 'perm_ban' ? 'Permanently banned' : 'Banned until ' + fmtDateTime(history.ban.ends_at) %></span>
    <% } else if (history.surcharge) { %>
      <span class="badge-status tone-amber"><i class="bi bi-cash-coin" aria-hidden="true"></i>+<%= peso(history.surcharge) %> per reservation</span>
    <% } else { %>
      <span class="badge-status tone-green"><i class="bi bi-check-circle" aria-hidden="true"></i>No active penalty</span>
    <% } %>
  </div>
  <div class="summary-body">
    <% if (!history.vehicles.length) { %>
      <div class="summary-row"><span class="k text-muted">No registered vehicle has this plate. Penalties still apply if it is registered later.</span></div>
    <% } %>
    <% history.vehicles.forEach(function (v) { %>
      <div class="summary-row">
        <span class="k"><i class="<%= vehicleIcon(v.vehicle_type) %> me-1" aria-hidden="true"></i><%= vehicleLabel(v) %><% if (v.color) { %> · <%= v.color %><% } %><% if (!v.is_active) { %> <span class="text-faint">(removed)</span><% } %></span>
        <span class="v"><a href="/admin/drivers/<%= v.user_id %>"><%= v.owner_name %></a></span>
      </div>
    <% }) %>
  </div>
</section>

<section class="summary-card mb-3">
  <div class="summary-head"><h3>Penalties</h3><span class="small text-muted"><%= history.penalties.length %> on record</span></div>
  <div class="summary-body">
    <% if (!history.penalties.length) { %><div class="summary-row"><span class="k text-muted">No penalties yet.</span></div><% } %>
    <% history.penalties.forEach(function (p) { %>
      <div class="summary-row">
        <span class="k">
          <strong><%= p.kind_label %></strong> <%- include('partials/status-badge', { kind: 'penalty', status: p.state }) %>
          <span class="d-block small text-faint"><%= p.summary %> · <%= fmtDateTime(p.created_at) %> by <%= p.created_by_name || 'system' %><% if (p.report_id) { %> · <a href="/admin/reports/<%= p.report_id %>">report #<%= p.report_id %></a><% } %></span>
          <span class="d-block small text-muted">Reason: <%= p.reason %></span>
          <% if (p.state === 'lifted') { %><span class="d-block small text-faint">Lifted <%= fmtDateTime(p.lifted_at) %> by <%= p.lifted_by_name || '—' %>: <%= p.lift_reason %></span><% } %>
        </span>
        <% if (p.state === 'active') { %>
          <span class="v">
            <form method="post" action="/admin/reports/penalties/<%= p.id %>/lift" data-confirm="Lift this <%= p.kind_label.toLowerCase() %> on <%= p.plate_number %>? It stops applying straight away." data-confirm-title="Lift penalty" data-confirm-label="Lift penalty" data-confirm-reason="Why is it lifted?">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="report_id" value="<%= locals.currentReportId || '' %>">
              <button class="btn btn-sm btn-outline-secondary" type="submit">Lift</button>
            </form>
          </span>
        <% } %>
      </div>
    <% }) %>
  </div>
</section>

<section class="summary-card">
  <div class="summary-head"><h3>Reports about this plate</h3><span class="small text-muted"><%= history.reports.length %> in total</span></div>
  <div class="summary-body">
    <% history.reports.forEach(function (r) { %>
      <div class="summary-row">
        <span class="k">
          <% if (r.id === locals.currentReportId) { %><strong>#<%= r.id %> (this report)</strong><% } else { %><a class="font-mono" href="/admin/reports/<%= r.id %>">#<%= r.id %></a><% } %>
          <%= r.violation_label %>
          <span class="d-block small text-faint"><%= fmtDateTime(r.incident_at) %> · reported by <%= r.reporter_name %></span>
        </span>
        <span class="v d-flex flex-wrap gap-1 justify-content-end">
          <% if (r.severity) { %><%- include('partials/status-badge', { kind: 'severity', status: r.severity }) %><% } %>
          <%- include('partials/status-badge', { kind: 'report', status: r.status }) %>
        </span>
      </div>
    <% }) %>
    <% if (!history.reports.length) { %><div class="summary-row"><span class="k text-muted">No reports.</span></div><% } %>
  </div>
</section>
