<%# Page title + breadcrumb, contextual search / actions and the profile menu. %>
<header class="app-header">
  <button class="btn btn-ghost btn-sm d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#appSidebar" aria-controls="appSidebar" aria-label="Open navigation menu">
    <i class="bi bi-list fs-5" aria-hidden="true"></i>
  </button>

  <div class="page-heading">
    <% if (breadcrumbs && breadcrumbs.length) { %>
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumb d-none d-sm-flex">
          <% breadcrumbs.forEach(function (crumb, i) { %>
            <% if (crumb.href && i < breadcrumbs.length - 1) { %>
              <li class="breadcrumb-item"><a href="<%= crumb.href %>"><%= crumb.label %></a></li>
            <% } else { %>
              <li class="breadcrumb-item active" aria-current="page"><%= crumb.label %></li>
            <% } %>
          <% }) %>
        </ol>
      </nav>
    <% } %>
    <h1 class="page-title"><%= title || appName %></h1>
  </div>

  <% if (currentUser.role === 'admin') { %>
    <form class="header-search d-none d-md-block" role="search" action="/admin/reservations" method="get">
      <i class="bi bi-search" aria-hidden="true"></i>
      <label class="visually-hidden" for="headerSearch">Search reservations by booking reference, driver or plate</label>
      <input id="headerSearch" class="form-control form-control-sm" type="search" name="q" placeholder="Search booking ref, driver or plate" autocomplete="off">
    </form>
  <% } else { %>
    <a class="btn btn-primary btn-sm d-none d-md-inline-flex" href="/driver/find-parking"><i class="bi bi-geo-alt" aria-hidden="true"></i> Find Parking</a>
  <% } %>

  <div class="dropdown">
    <button class="btn btn-ghost btn-sm d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Account menu">
      <span class="avatar" style="width:28px;height:28px;font-size:.72rem" aria-hidden="true"><%= initials(currentUser.full_name) %></span>
      <span class="d-none d-md-inline"><%= currentUser.full_name.split(' ')[0] %></span>
      <i class="bi bi-chevron-down small" aria-hidden="true"></i>
    </button>
    <ul class="dropdown-menu dropdown-menu-end" style="min-width: 240px;">
      <li class="px-3 py-2">
        <div class="fw-semibold"><%= currentUser.full_name %></div>
        <div class="small text-muted"><%= currentUser.email %></div>
        <div class="mt-1"><%- include('status-badge', { kind: 'user', status: currentUser.role }) %></div>
      </li>
      <li><hr class="dropdown-divider"></li>
      <% if (currentUser.role === 'admin') { %>
        <li><a class="dropdown-item" href="/admin/settings"><i class="bi bi-gear me-2" aria-hidden="true"></i>Settings</a></li>
      <% } else { %>
        <li><a class="dropdown-item" href="/driver/profile"><i class="bi bi-person-circle me-2" aria-hidden="true"></i>Profile</a></li>
        <li><a class="dropdown-item" href="/driver/vehicles"><i class="bi bi-car-front me-2" aria-hidden="true"></i>My Vehicles</a></li>
      <% } %>
      <li>
        <form method="post" action="/logout">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="dropdown-item" type="submit"><i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Sign out</button>
        </form>
      </li>
    </ul>
  </div>
</header>
