<!doctype html>
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0B1220">
  <title><%= title ? title + ' · ' : '' %>University Parking</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/components.css">
</head>
<body class="auth-body">
  <a class="skip-link" href="#main">Skip to content</a>
  <main id="main" class="auth-wrap">
    <section class="auth-brand" aria-label="University Parking">
      <div class="brand-mark brand-mark-lg" aria-hidden="true">P</div>
      <h1 class="auth-tagline">Reserve. Park. Go.</h1>
      <p class="auth-sub">Book a campus parking slot by the hour, see what is free right now, and pay the parking office in person.</p>
      <ul class="auth-legend" aria-label="Slot colours">
        <li><span class="dot dot-available"></span>Available</li>
        <li><span class="dot dot-reserved"></span>Reserved</li>
        <li><span class="dot dot-occupied"></span>Occupied</li>
        <li><span class="dot dot-unavailable"></span>Unavailable</li>
      </ul>
    </section>
    <section class="auth-card"><%- body %></section>
  </main>
  <script src="/js/app.js"></script>
</body>
</html>
