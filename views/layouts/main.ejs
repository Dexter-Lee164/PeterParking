<!doctype html>
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0B1220">
  <title><%= title ? title + ' · ' : '' %>University Parking</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/parking-slots.css">
  <noscript><link rel="stylesheet" href="/css/no-js.css"></noscript>
</head>
<body class="app-body">
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="app-shell">
    <%- include('../partials/app-sidebar') %>
    <div class="app-main">
      <%- include('../partials/app-header') %>
      <main id="main" class="app-content" tabindex="-1">
        <%- body %>
      </main>
    </div>
  </div>
  <%- include('../partials/toast') %>
  <%- include('../partials/confirm-modal') %>
  <form id="logout-form" method="post" action="/logout" class="d-none"><input type="hidden" name="_csrf" value="<%= csrfToken %>"></form>
  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js"></script>
  <% (typeof scripts !== 'undefined' ? scripts : []).forEach(function (s) { %><script src="<%= s %>"></script>
  <% }) %>
</body>
</html>
