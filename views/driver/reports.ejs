<div class="page-intro">
  <div>
    <h2>Parking Etiquette Reports</h2>
    <p>Report a vehicle that broke the parking rules. Parking administration reviews every report; your name is never shown to the other driver.</p>
  </div>
</div>

<% if (unreadTotal) { %>
  <div class="unread-banner" role="status"><i class="bi bi-bell-fill" aria-hidden="true"></i><span><%= unreadTotal === 1 ? '1 update is' : unreadTotal + ' updates are' %> highlighted below.</span></div>
<% } %>

<div class="row g-3">
  <div class="col-lg-7">
    <%# ------------------------------------------------ penalties on the driver's own plates %>
    <% if (penalties.length) { %>
      <section class="summary-card mb-3" id="penalties">
        <div class="summary-head"><h3><i class="bi bi-shield-exclamation me-1" aria-hidden="true"></i>Penalties on your vehicles</h3></div>
        <div class="summary-body">
          <% penalties.forEach(function (p) { %>
            <div class="summary-row<%= isUnread('plate_penalty', p.id) ? ' is-unread' : '' %>">
              <span class="k">
                <span class="plate"><%= p.plate_number %></span> <strong class="ms-1"><%= p.kind_label %></strong>
                <% if (isUnread('plate_penalty', p.id)) { %><span class="new-pill">New</span><% } %>
                <span class="d-block small text-faint"><%= p.summary %> · from <%= fmtDateTime(p.starts_at) %></span>
                <span class="d-block small text-muted">Reason: <%= p.reason %></span>
                <% if (p.state === 'lifted') { %><span class="d-block small text-faint">Lifted <%= fmtDateTime(p.lifted_at) %>: <%= p.lift_reason %></span><% } %>
              </span>
              <span class="v"><%- include('partials/status-badge', { kind: 'penalty', status: p.state }) %></span>
            </div>
          <% }) %>
        </div>
      </section>
    <% } %>

    <%# ------------------------------------------------ reports the driver submitted %>
    <div class="section-title"><h3>Your reports</h3></div>
    <div class="table-wrap">
      <% if (!rows.length) { %>
        <%- include('partials/empty-state', { icon: 'bi-flag', title: 'No reports yet', text: 'Use the form to report a vehicle that broke the parking rules.' }) %>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover table-stack mb-0">
            <caption class="visually-hidden">Parking etiquette reports you submitted</caption>
            <thead><tr><th scope="col">Report</th><th scope="col">Plate</th><th scope="col">Violation</th><th scope="col">Incident</th><th scope="col">Status</th></tr></thead>
            <tbody>
              <% rows.forEach(function (r) { const fresh = isUnread('etiquette_report', r.id); %>
                <tr class="<%= fresh ? 'is-unread' : '' %>">
                  <td data-label="Report"><a class="font-mono fw-semibold" href="/driver/reports/<%= r.id %>">#<%= r.id %></a><% if (fresh) { %><span class="new-pill">Updated</span><% } %></td>
                  <td data-label="Plate"><span class="plate"><%= r.plate_number %></span></td>
                  <td data-label="Violation"><%= r.violation_label %></td>
                  <td data-label="Incident"><%= fmtDateTime(r.incident_at) %></td>
                  <td data-label="Status"><%- include('partials/status-badge', { kind: 'report', status: r.status }) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <%- include('partials/pagination', { pager: pager, baseQuery: {}, noun: 'reports' }) %>
      <% } %>
    </div>
  </div>

  <div class="col-lg-5">
    <section class="summary-card">
      <div class="summary-head"><h3><i class="bi bi-flag me-1" aria-hidden="true"></i>Report a violation</h3></div>
      <div class="p-3">
        <% if (formError) { %><div class="alert alert-danger small" role="alert"><%= formError %></div><% } %>
        <form method="post" action="/driver/reports" novalidate data-etiquette-form data-max-bytes="<%= maxEvidenceBytes %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="evidence_data" value="">
          <div class="row g-3">
            <%- include('partials/form-field', { name: 'plate_number', label: 'Plate number of the vehicle', value: values.plate_number, errors: errors, required: true, placeholder: 'ABC 1234', maxlength: 12, autocomplete: 'off', attrs: { style: 'text-transform:uppercase' } }) %>
            <%- include('partials/form-field', { name: 'violation_type', label: 'Type of violation', type: 'select', value: values.violation_type, errors: errors, required: true, options: violationOptions }) %>
            <%- include('partials/form-field', { name: 'incident_date', label: 'Date', type: 'date', value: values.incident_date, errors: errors, required: true, col: 'col-sm-6', min: minDate, max: maxDate }) %>
            <%- include('partials/form-field', { name: 'incident_time', label: 'Time', type: 'time', value: values.incident_time, errors: errors, required: true, col: 'col-sm-6' }) %>
            <%- include('partials/form-field', { name: 'description', label: 'What happened', type: 'textarea', value: values.description, errors: errors, required: true, rows: 4, maxlength: 1000, placeholder: 'Where it happened and what you saw, e.g. "Parked across MB-14 and MB-15 from 9 to 11 AM."' }) %>
            <div class="col-12">
              <label class="form-label" for="evidenceFile">Supporting image (optional)</label>
              <input class="form-control<%= errors.evidence ? ' is-invalid' : '' %>" type="file" id="evidenceFile" accept="image/jpeg,image/png,image/webp,image/gif" aria-describedby="evidenceHelp<%= errors.evidence ? ' evidenceError' : '' %>">
              <% if (errors.evidence) { %><div class="invalid-feedback d-block" id="evidenceError"><%= errors.evidence %></div><% } %>
              <div class="form-text" id="evidenceHelp">JPEG, PNG, WebP or GIF, up to 2 MB.<noscript> Attaching an image needs JavaScript.</noscript></div>
              <img class="evidence-preview mt-2" id="evidencePreview" alt="Preview of the attached image" hidden>
            </div>
            <div class="col-12">
              <button class="btn btn-primary w-100" type="submit"><i class="bi bi-send" aria-hidden="true"></i> Submit report</button>
            </div>
          </div>
        </form>
      </div>
    </section>
  </div>
</div>
