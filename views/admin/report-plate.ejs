<div class="page-intro">
  <div>
    <h2>Plate <%= plate %></h2>
    <p>Every report and penalty for this plate. Penalties stay with the plate, whoever registers it.</p>
  </div>
  <a class="btn btn-outline-secondary btn-sm" href="/admin/reports"><i class="bi bi-arrow-left" aria-hidden="true"></i> All reports</a>
</div>

<% if (formError) { %><div class="alert alert-danger" role="alert"><i class="bi bi-exclamation-octagon me-2" aria-hidden="true"></i><%= formError %></div><% } %>

<div class="row g-3">
  <div class="col-xl-7">
    <%- include('partials/plate-history', { history: history }) %>
  </div>
  <div class="col-xl-5">
    <%- include('partials/penalty-form', { action: '/admin/reports/plate/' + encodeURIComponent(history.key) + '/penalties', plate: plate }) %>
  </div>
</div>
