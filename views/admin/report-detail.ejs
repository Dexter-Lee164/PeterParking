<div class="page-intro">
  <div>
    <h2>Report #<%= report.id %></h2>
    <p>Submitted <%= fmtDateTime(report.created_at) %> by <%= report.reporter_name %> (<%= report.reporter_email %>).</p>
  </div>
  <a class="btn btn-outline-secondary btn-sm" href="/admin/reports"><i class="bi bi-arrow-left" aria-hidden="true"></i> All reports</a>
</div>

<% if (formError) { %><div class="alert alert-danger" role="alert"><i class="bi bi-exclamation-octagon me-2" aria-hidden="true"></i><%= formError %></div><% } %>

<div class="row g-3">
  <div class="col-xl-7">
    <%- include('partials/summary-card', {
      title: 'Reported violation',
      badgeHtml: include('partials/status-badge', { kind: 'report', status: report.status }),
      items: [
        { label: 'Plate number', value: report.plate_number },
        { label: 'Violation', value: report.violation_label },
        { label: 'Incident', value: fmtDateTime(report.incident_at) },
        { label: 'What happened', value: report.description },
        { label: 'Severity', value: report.severity_label || 'Not assessed yet' },
        { label: 'Last reviewed', value: report.reviewed_at ? fmtDateTime(report.reviewed_at) + ' by ' + report.reviewer_name : 'Not yet' }
      ]
    }) %>

    <% if (report.has_evidence) { %>
      <section class="summary-card mt-3">
        <div class="summary-head"><h3>Supporting image</h3></div>
        <div class="p-3"><a href="/admin/reports/<%= report.id %>/evidence" target="_blank" rel="noopener"><img class="evidence-image" src="/admin/reports/<%= report.id %>/evidence" alt="Image attached to report #<%= report.id %>"></a></div>
      </section>
    <% } %>

    <%# ------------------------------------------------ review: status, severity, notes %>
    <section class="summary-card mt-3" id="review">
      <div class="summary-head"><h3><i class="bi bi-clipboard-check me-1" aria-hidden="true"></i>Review</h3></div>
      <div class="p-3">
        <form method="post" action="/admin/reports/<%= report.id %>/review" novalidate
              data-confirm="Save this review of report #<%= report.id %>? The reporter sees the new status and your notes." data-confirm-title="Save review" data-confirm-label="Save review">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="row g-3">
            <%- include('partials/form-field', { name: 'status', label: 'Status', type: 'select', value: values.status, errors: errors, required: true, col: 'col-sm-6', options: statusOptions }) %>
            <%- include('partials/form-field', { name: 'severity', label: 'Severity', type: 'select', value: values.severity, errors: errors, col: 'col-sm-6', options: severityOptions }) %>
            <%- include('partials/form-field', { name: 'admin_notes', label: 'Notes for the reporter', type: 'textarea', value: values.admin_notes, errors: errors, rows: 3, maxlength: 1000, help: 'Required when dismissing a report.' }) %>
            <div class="col-12"><button class="btn btn-primary" type="submit"><i class="bi bi-check2" aria-hidden="true"></i> Save review</button></div>
          </div>
        </form>
      </div>
    </section>

    <div class="mt-3">
      <%- include('partials/penalty-form', { action: '/admin/reports/' + report.id + '/penalties', plate: report.plate_number }) %>
    </div>
  </div>

  <div class="col-xl-5">
    <%- include('partials/plate-history', { history: history, currentReportId: report.id }) %>
  </div>
</div>
