<% const checkInBtn = function (r) {
     if (r.eligibility.ok) return '<form class="inline-form" method="post" action="/admin/operations/check-in"><input type="hidden" name="_csrf" value="' + csrfToken + '"><input type="hidden" name="reference" value="' + h.esc(r.reference) + '"><button class="btn btn-sm btn-primary" type="submit">' + h.icon('check', 15) + 'Check in</button></form>';
     return '<span class="text-muted small">' + h.esc(r.eligibility.reason) + '</span>'; }; %>
<section class="card-surface search-card" aria-labelledby="lk-h">
  <div class="card-head"><div><h2 id="lk-h">Find a booking</h2><p>Search by booking reference or plate number, verify it, then record arrival or departure.</p></div></div>
  <%- include('../partials/filter-toolbar', { action: '/admin/operations', submitLabel: 'Look up', values: { q: q }, resetHref: q ? '/admin/operations' : '', fields: [
    { name: 'q', label: 'Booking reference or plate number', type: 'search', cls: 'grow-2', placeholder: 'UP-20261016-AB3CD or ABC1234', attrs: 'autofocus autocomplete="off"' } ] }) %>
  <% if (q) { %>
    <div class="mt-3">
      <% if (!results.length) { %>
        <%- include('../partials/empty-state', { icon: 'search', title: 'No open booking found', text: 'Nothing upcoming or parked matches “' + q + '”. Check the spelling, or look at Reservations for past bookings.' }) %>
      <% } else { %>
        <ul class="list-plain">
          <% results.forEach(function (r) { %>
            <li class="list-row flex-wrap">
              <span class="meta"><a class="mono fw-bold" href="/admin/reservations/<%= r.reference %>"><%= r.reference %></a>
                <span class="text-muted small"><%= r.driver_name %> · <span class="mono"><%= r.plate_number %></span> · Slot <%= r.slot_code %> (<%= r.zone_name %>) · <%= h.fmtRange(r.start_at, r.end_at) %></span></span>
              <span class="d-flex align-items-center gap-2 flex-wrap"><%- h.statusBadge('reservation', r.status) %><%- h.statusBadge('payment', r.bal.status) %>
                <% if (r.status === 'active') { %><span class="text-muted small">Checked in — use the table below to check out.</span><% } else { %><%- checkInBtn(r) %><% } %></span>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  <% } %>
</section>

<div class="page-grid">
  <section class="card-surface col-span-12" aria-labelledby="as-h">
    <div class="card-head"><div><h2 id="as-h">Active parking sessions</h2><p><%= sessions.length %> vehicle<%= sessions.length === 1 ? '' : 's' %> parked now</p></div></div>
    <%- include('../partials/data-table', { caption: 'Active sessions', rows: sessions, pg: null, empty: { icon: 'car', title: 'No vehicles checked in', text: 'Checked-in vehicles appear here with elapsed time and the running fee.' }, columns: [
      { label: 'Slot', render: function (s) { return h.stack('<strong>' + h.esc(s.slot_code) + '</strong>', s.zone_name); } },
      { label: 'Vehicle', render: function (s) { return h.stack('<span class="mono">' + h.esc(s.plate_number) + '</span>', s.driver_name); } },
      { label: 'Booking', render: function (s) { return h.link('/admin/reservations/' + s.reference, s.reference, 'mono'); } },
      { label: 'Checked in', render: function (s) { return h.stack(h.esc(h.fmtTime(s.checked_in_at)), s.is_late ? 'Late by ' + h.fmtDuration(s.late_minutes) : 'On time'); } },
      { label: 'Elapsed', render: function (s) { return h.esc(h.fmtDuration(s.elapsedMinutes)); } },
      { label: 'Expected out', render: function (s) { return h.stack(h.esc(h.fmtTime(s.end_at)), s.overstaying ? 'Overstaying ' + h.fmtDuration(s.overstayMinutesNow) : (s.rate_centavos ? h.pesos(s.rate_centavos) + '/hr' : '')); } },
      { label: 'Fee if out now', cls: 'num', render: function (s) { return h.esc(h.pesos(s.projectedFee)); } },
      { label: 'Flags', render: function (s) { return (s.is_late ? h.statusBadge('session', 'late') : '') + (s.overstaying ? ' ' + h.statusBadge('session', 'overstay') : '') || '<span class="text-muted">—</span>'; } },
      { label: '', cls: 'text-end', render: function (s) { return '<button class="btn btn-sm btn-outline-light" type="button" data-bs-toggle="modal" data-bs-target="#confirmModal" data-confirm-action="/admin/operations/check-out" data-confirm-fields=\'' + h.esc(JSON.stringify({ sessionId: String(s.id) })) + '\' data-confirm-title="Check out ' + h.esc(s.plate_number) + '?" data-confirm-message="Records departure now and finalizes the fee (' + h.esc(h.pesos(s.projectedFee)) + ' if out now)." data-confirm-label="Check out" data-confirm-tone="primary">' + h.icon('logout', 15) + 'Check out</button>'; } } ] }) %>
  </section>
  <section class="card-surface col-span-12" aria-labelledby="ar-h">
    <div class="card-head"><div><h2 id="ar-h">Expected arrivals today</h2><p>Check-in opens <%= settings.early_checkin_minutes %> min before the start. Arrivals more than <%= settings.late_grace_minutes %> min late are flagged.</p></div></div>
    <%- include('../partials/data-table', { caption: 'Expected arrivals', rows: arrivals, pg: null, empty: { icon: 'calendar', title: 'No more arrivals expected today' }, columns: [
      { label: 'Booking', render: function (r) { return h.link('/admin/reservations/' + r.reference, r.reference, 'mono'); } },
      { label: 'Driver', render: function (r) { return h.stack(h.esc(r.driver_name), r.plate_number); } },
      { label: 'Slot', render: function (r) { return h.stack(h.esc(r.slot_code), r.zone_name); } },
      { label: 'Time', render: function (r) { return h.esc(h.fmtTime(r.start_at) + ' – ' + h.fmtTime(r.end_at)); } },
      { label: '', cls: 'text-end', render: checkInBtn } ] }) %>
  </section>
</div>
