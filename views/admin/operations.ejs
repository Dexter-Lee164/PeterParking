<div class="page-intro">
  <div>
    <h2>Check-in / Check-out</h2>
    <p>Occupancy changes only when you confirm an arrival or departure here. Reserved does not mean occupied.</p>
  </div>
</div>

<section class="summary-card mb-4" aria-labelledby="lookupTitle">
  <div class="summary-head"><h3 id="lookupTitle">Find a booking</h3></div>
  <div class="p-3">
    <form method="get" action="/admin/operations" class="row g-2 align-items-end" role="search">
      <div class="col-12 col-md">
        <label class="form-label" for="opsQuery">Booking reference or plate number</label>
        <input class="form-control form-control-lg" id="opsQuery" name="q" type="search" value="<%= q %>" placeholder="e.g. UP-20261018-0042 or ABC 1234" autocomplete="off" autofocus>
      </div>
      <div class="col-12 col-md-auto"><button class="btn btn-primary btn-lg w-100" type="submit"><i class="bi bi-search" aria-hidden="true"></i> Search</button></div>
    </form>

    <% if (q) { %>
      <div class="mt-3" aria-live="polite">
        <% if (!results.length) { %>
          <div class="alert alert-warning mb-0" role="status">No confirmed or checked-in reservation matches “<%= q %>”. Check the reference or plate, or look under <a href="/admin/reservations?q=<%= encodeURIComponent(q) %>">all reservations</a>.</div>
        <% } else { %>
          <div class="d-grid gap-2">
            <% results.forEach(function (r) { %>
              <div class="ops-card <%= r.is_late ? 'is-flagged' : '' %>">
                <div class="d-flex flex-wrap justify-content-between gap-2">
                  <div>
                    <a class="font-mono fw-semibold" href="/admin/reservations/<%= r.id %>"><%= r.booking_ref %></a>
                    <span class="plate ms-2"><%= r.plate_number %></span>
                    <div class="small text-muted mt-1"><%= r.driver_name %> · Slot <strong><%= r.slot_code %></strong> (<%= r.zone_name %>) · <%= fmtDate(r.start_at) %>, <%= fmtTime(r.start_at) %> – <%= fmtTime(r.end_at) %></div>
                  </div>
                  <div class="d-flex flex-wrap align-items-start gap-2">
                    <%- include('partials/status-badge', { kind: 'reservation', status: r.status }) %>
                    <% if (r.is_late) { %><%- include('partials/status-badge', { kind: 'session', status: 'late' }) %><% } %>
                  </div>
                </div>
                <div class="mt-2">
                  <% if (r.status === 'confirmed' && !r.can_check_in && now < r.start_at) { %>
                    <p class="small text-muted mb-2">Check-in opens <%= settingsEarly %> minutes before the start time.</p>
                  <% } %>
                  <%- include('partials/ops-actions', { r: r, q: q, canIn: r.can_check_in, canOut: r.can_check_out, canNoShow: false }) %>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    <% } %>
  </div>
</section>

<div class="row g-3">
  <div class="col-xl-6">
    <div class="section-title"><h3>Currently parked <span class="chip ms-1"><%= parked.length %></span></h3></div>
    <% if (!parked.length) { %>
      <div class="table-wrap"><%- include('partials/empty-state', { icon: 'bi-p-square', title: 'Nothing parked', text: 'Vehicles appear here after you check them in.' }) %></div>
    <% } else { %>
      <div class="d-grid gap-2">
        <% parked.forEach(function (p) { %>
          <div class="ops-card <%= p.overstaying ? 'is-overstay' : '' %>">
            <div class="d-flex flex-wrap justify-content-between gap-2">
              <div>
                <span class="plate"><%= p.plate_number %></span>
                <a class="font-mono ms-2" href="/admin/reservations/<%= p.id %>"><%= p.booking_ref %></a>
                <div class="small text-muted mt-1"><%= p.driver_name %> · Slot <strong><%= p.slot_code %></strong> (<%= p.zone_name %>)</div>
                <div class="small text-muted">In at <%= fmtTime(p.check_in_at) %> · <%= fmtDuration(p.elapsed_minutes) %> parked · reserved until <%= fmtTime(p.end_at) %></div>
              </div>
              <div>
                <% if (p.overstaying) { %>
                  <%- include('partials/status-badge', { kind: 'session', status: 'overstay', badgeLabel: 'Over by ' + fmtDuration(p.overstay_minutes_so_far) }) %>
                <% } else { %>
                  <%- include('partials/status-badge', { kind: 'session', status: 'parked', badgeLabel: fmtDuration(p.minutes_remaining) + ' left' }) %>
                <% } %>
              </div>
            </div>
            <div class="mt-2"><%- include('partials/ops-actions', { r: p, q: '', canIn: false, canOut: true, canNoShow: false }) %></div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <div class="col-xl-6">
    <div class="section-title"><h3>Expected arrivals today <span class="chip ms-1"><%= arrivals.length %></span></h3></div>
    <% if (!arrivals.length) { %>
      <div class="table-wrap"><%- include('partials/empty-state', { icon: 'bi-calendar-check', title: 'No pending arrivals', text: 'Confirmed bookings for the rest of today will be listed here.' }) %></div>
    <% } else { %>
      <div class="d-grid gap-2">
        <% arrivals.forEach(function (a) { %>
          <div class="ops-card <%= a.is_late ? 'is-flagged' : '' %>">
            <div class="d-flex flex-wrap justify-content-between gap-2">
              <div>
                <span class="plate"><%= a.plate_number %></span>
                <a class="font-mono ms-2" href="/admin/reservations/<%= a.id %>"><%= a.booking_ref %></a>
                <div class="small text-muted mt-1"><%= a.driver_name %> · Slot <strong><%= a.slot_code %></strong> (<%= a.zone_name %>)</div>
                <div class="small text-muted"><%= fmtTime(a.start_at) %> – <%= fmtTime(a.end_at) %><% if (a.is_late) { %> · <strong class="text-warning"><%= fmtDuration(a.late_minutes) %> late</strong><% } %></div>
              </div>
              <% if (a.is_late) { %><div><%- include('partials/status-badge', { kind: 'session', status: 'late' }) %></div><% } %>
            </div>
            <div class="mt-2"><%- include('partials/ops-actions', { r: a, q: '', canIn: a.can_check_in, canOut: false, canNoShow: a.can_mark_no_show }) %></div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>
