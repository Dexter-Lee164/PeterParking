<div class="page-intro">
  <div>
    <h2>Reservations</h2>
    <p>Today's bookings come first, then upcoming ones (soonest first), then past ones (most recent first). Every booking stays on record.</p>
  </div>
</div>

<%- include('partials/unread-banner') %>

<%- include('partials/filter-toolbar', {
  formId: 'resFilter',
  action: '/admin/reservations',
  submitLabel: 'Filter',
  resetHref: '/admin/reservations',
  fields: [
    { type: 'search', name: 'q', label: 'Search', value: filters.q, placeholder: 'Booking ref, driver, plate, slot', col: 'col-12 col-md-4' },
    { type: 'select', name: 'status', label: 'Status', value: filters.status, options: statusOptions, col: 'col-6 col-md-2' },
    { type: 'select', name: 'zone', label: 'Zone', value: filters.zone, options: zoneOptions, col: 'col-6 col-md-2' },
    { type: 'select', name: 'payment', label: 'Payment', value: filters.payment, options: paymentOptions, col: 'col-6 col-md-2' },
    { type: 'date', name: 'from', label: 'From date', value: filters.from, col: 'col-6 col-md-2' },
    { type: 'date', name: 'to', label: 'To date', value: filters.to, col: 'col-6 col-md-2' }
  ]
}) %>

<%- include('partials/data-table', {
  caption: 'All reservations',
  columns: [{ label: 'Reference' }, { label: 'Driver' }, { label: 'Vehicle' }, { label: 'Slot' }, { label: 'When' }, { label: 'Fee', align: 'end' }, { label: 'Payment' }, { label: 'Status' }, { label: '' }],
  rows: rows,
  rowPartial: 'partials/rows/admin-reservation-row',
  pager: pager,
  baseQuery: baseQuery,
  noun: 'reservations',
  empty: { icon: 'bi-calendar2-x', title: 'No reservations found', text: 'Adjust the filters, or clear them to see every booking.' }
}) %>
