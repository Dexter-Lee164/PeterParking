<div class="page-intro">
  <div>
    <h2>Payments</h2>
    <p>Paid bookings and their receipts. A check-out with a fee owed goes straight to recording its payment.</p>
  </div>
  <a class="btn btn-primary" href="/admin/payments/new"><i class="bi bi-plus-lg" aria-hidden="true"></i> Record payment</a>
</div>

<%- include('partials/unread-banner') %>

<div class="row g-3 mb-4">
  <div class="col-md-4"><%- include('partials/stat-card', { label: 'Collected today', value: peso(todayTotal), hint: 'Valid payments recorded today', icon: 'bi-cash-coin', tone: 'green' }) %></div>
</div>

<%- include('partials/filter-toolbar', {
  formId: 'payFilter',
  action: '/admin/payments',
  hideSubmit: true,
  toolbarClass: 'filter-bar mb-3',
  fields: [
    { type: 'search', name: 'q', label: 'Search', value: filters.q, placeholder: 'Receipt, reference, booking, driver, plate', col: 'col-12 col-md-4', attrs: { 'data-autosubmit': '' } },
    { type: 'select', name: 'method', label: 'Method', value: filters.method, options: methodOptions, col: 'col-6 col-md-2', attrs: { 'data-autosubmit': '' } },
    { type: 'date', name: 'from', label: 'From date', value: filters.from, col: 'col-6 col-md-2', attrs: { 'data-autosubmit': '' } },
    { type: 'date', name: 'to', label: 'To date', value: filters.to, col: 'col-6 col-md-2', attrs: { 'data-autosubmit': '' } }
  ]
}) %>

<%- include('partials/data-table', {
  caption: 'Paid bookings',
  columns: [{ label: 'Receipt' }, { label: 'Booking' }, { label: 'Driver' }, { label: 'Paid on' }, { label: 'Method' }, { label: 'Amount', align: 'end' }, { label: 'Status' }, { label: '' }],
  rows: rows,
  rowPartial: 'partials/rows/admin-payment-row',
  pager: pager,
  baseQuery: baseQuery,
  noun: 'payments',
  empty: { icon: 'bi-receipt', title: 'No payments found', text: 'Record a payment when a driver settles their parking fee.', actionHref: '/admin/payments/new', actionLabel: 'Record payment' }
}) %>
