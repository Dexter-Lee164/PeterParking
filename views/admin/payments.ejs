<div class="page-intro">
  <div>
    <h2>Payments</h2>
    <p>Paid bookings and their receipts. A check-out with a fee owed goes straight to recording its payment.</p>
  </div>
  <a class="btn btn-primary" href="/admin/payments/new"><i class="bi bi-plus-lg" aria-hidden="true"></i> Record payment</a>
</div>

<%- include('partials/unread-banner') %>

<div class="row g-3 mb-4">
  <div class="col-md-4"><%- include('partials/stat-card', { label: 'Collected today', value: peso(todayTotal), hint: 'Valid payments recorded today', icon: 'bi-cash-coin', tone: 'green' }) %></div>
  <div class="col-md-4"><%- include('partials/stat-card', { label: 'Collected this month', value: peso(monthTotal), hint: 'Since the 1st of the month', icon: 'bi-calendar-check', tone: 'blue' }) %></div>
  <div class="col-md-4"><%- include('partials/stat-card', { label: 'Receipts today', value: receiptsToday, hint: receiptsToday === 1 ? '1 receipt issued' : receiptsToday + ' receipts issued', icon: 'bi-receipt', tone: 'teal' }) %></div>
</div>

<%- include('partials/filter-toolbar', {
  formId: 'payFilter',
  action: '/admin/payments',
  hideSubmit: true,
  toolbarClass: 'filter-bar mb-3',
  fields: [
    { type: 'search', name: 'q', label: 'Search', value: filters.q, placeholder: 'Receipt, booking, driver, plate', attrs: { 'data-autosubmit': '' } },
    { type: 'select', name: 'method', label: 'Method', value: filters.method, options: methodOptions, attrs: { 'data-autosubmit': '' } },
    { type: 'date', name: 'from', label: 'From date', value: filters.from, attrs: { 'data-autosubmit': '' } },
    { type: 'date', name: 'to', label: 'To date', value: filters.to, attrs: { 'data-autosubmit': '' } }
  ]
}) %>

<%- include('partials/data-table', {
  caption: 'Paid bookings',
  columns: [{ label: 'Receipt' }, { label: 'Booking' }, { label: 'Driver' }, { label: 'Paid on' }, { label: 'Method' }, { label: 'Amount', align: 'end' }, { label: 'Status' }, { label: '' }],
  rows: rows,
  rowPartial: 'partials/rows/admin-payment-row',
  pager: pager,
  baseQuery: baseQuery,
  noun: 'payments',
  empty: { icon: 'bi-receipt', title: 'No payments found', text: 'Record a payment when a driver settles their parking fee.', actionHref: '/admin/payments/new', actionLabel: 'Record payment' }
}) %>
