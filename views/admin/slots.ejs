<div class="page-intro">
  <div>
    <h2>Parking Slots</h2>
    <p>The parking layout is fixed. Manage how slots operate: put a slot into maintenance, take it out of service or return it. Slots with upcoming reservations cannot be taken out of service until those bookings are cancelled.</p>
  </div>
</div>

<%- include('partials/filter-toolbar', {
  formId: 'slotFilter',
  action: '/admin/slots',
  hideSubmit: true,
  resetHref: '/admin/slots?zone=' + filters.zone,
  toolbarClass: 'filter-bar mb-3',
  fields: [
    { type: 'hidden', name: 'zone', value: filters.zone },
    { type: 'search', name: 'q', label: 'Search slot code or note', value: filters.q, placeholder: 'e.g. A-05', col: 'col-12 col-md-4', attrs: { 'data-autosubmit': '' } },
    { type: 'select', name: 'status', label: 'Status', value: filters.status, col: 'col-6 col-md-3', attrs: { 'data-autosubmit': '' }, options: [{ value: '', label: 'Any status' }].concat(statusOptions) },
    { type: 'select', name: 'type', label: 'Slot type', value: filters.type, col: 'col-6 col-md-3', attrs: { 'data-autosubmit': '' }, options: [{ value: '', label: 'Any type' }].concat(slotTypes.map(function (t) { return { value: t.code, label: t.label }; })) }
  ]
}) %>

<nav class="nav-pills-tabs mb-3" aria-label="Filter by zone">
  <% zones.forEach(function (z) { %>
    <a href="/admin/slots?zone=<%= z.id %>" class="<%= filters.zone === z.id ? 'active' : '' %>" <%- filters.zone === z.id ? 'aria-current="page"' : '' %>>
      <%= z.name %> <span class="count"><%= z.slot_count %></span><% if (!z.is_active) { %> <span class="small">(inactive)</span><% } %>
    </a>
  <% }) %>
</nav>

<% const activeZone = zones.find(function (z) { return z.id === filters.zone; }); %>
<% if (activeZone) { %>
  <section class="summary-card mb-3">
    <div class="summary-head">
      <h3><%= activeZone.name %> <span class="chip ms-1"><%= activeZone.code %></span></h3>
      <span class="small text-muted"><i class="bi bi-lock me-1" aria-hidden="true"></i>Fixed layout</span>
    </div>
    <div class="p-3 small text-muted">
      <%= activeZone.active_slot_count %> of <%= activeZone.slot_count %> slots in service
      · <%= activeZone.is_active ? 'Visible to drivers' : 'Hidden from drivers' %>
    </div>
  </section>

  <% if (mapSlots.length) { %>
    <%- include('partials/lot-defs') %>
    <section class="map-card mb-3" aria-label="Lot map for <%= activeZone.name %>" data-admin-slot-map>
      <%- include('partials/parking-map', { zone: zone, slots: mapSlots, selectedSlotId: null, linkAll: true }) %>
      <div class="map-legend">
        <span class="lg"><span class="swatch s-available"></span> Available</span>
        <span class="lg"><span class="swatch s-reserved"></span> Reserved now</span>
        <span class="lg"><span class="swatch s-occupied"></span> Occupied</span>
        <span class="lg"><span class="swatch s-unavailable"></span> Out of service</span>
        <span class="lg"><span class="swatch s-maintenance"></span> Maintenance</span>
        <span class="map-counts">Choose a slot to change its status, notes or rate.</span>
      </div>
    </section>
  <% } %>
<% } %>

<div class="d-flex flex-wrap gap-2 mb-3" role="list" aria-label="Live slot counts for the current filter">
  <span class="chip" role="listitem"><%= counts.total %> slots</span>
  <span class="badge-status tone-green" role="listitem"><i class="bi bi-check-circle-fill" aria-hidden="true"></i><%= counts.available %> available</span>
  <span class="badge-status tone-blue" role="listitem"><i class="bi bi-bookmark-fill" aria-hidden="true"></i><%= counts.reserved %> reserved</span>
  <span class="badge-status tone-red" role="listitem"><i class="bi bi-car-front-fill" aria-hidden="true"></i><%= counts.occupied %> occupied</span>
  <span class="badge-status tone-gray" role="listitem"><i class="bi bi-slash-circle-fill" aria-hidden="true"></i><%= counts.unavailable %> unavailable</span>
</div>

<%- include('partials/data-table', {
  caption: 'Parking slots',
  columns: [{ label: 'Slot' }, { label: 'Zone' }, { label: 'Type' }, { label: 'Rate / hr', align: 'end' }, { label: 'Status' }, { label: 'Right now' }, { label: '' }],
  rows: slots,
  rowPartial: 'partials/rows/admin-slot-row',
  empty: { icon: 'bi-grid-3x3-gap', title: 'No slots match', text: 'Try clearing the filters.' }
}) %>
