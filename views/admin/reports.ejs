<div class="page-intro">
  <div>
    <h2>Parking Etiquette Reports</h2>
    <p>Reports drivers submitted about other vehicles. Review each one, then penalise the plate or dismiss the report.</p>
  </div>
</div>

<% if (unreadTotal) { %>
  <div class="unread-banner" role="status"><i class="bi bi-bell-fill" aria-hidden="true"></i><span><%= unreadTotal === 1 ? '1 new report is' : unreadTotal + ' new reports are' %> highlighted below.</span></div>
<% } %>

<div class="row g-3 mb-4">
  <div class="col-6 col-md-4"><%- include('partials/stat-card', { label: 'Under review', value: counts.under_review || 0, hint: 'Waiting for a decision', icon: 'bi-search', tone: (counts.under_review || 0) > 0 ? 'amber' : 'green' }) %></div>
  <div class="col-6 col-md-4"><%- include('partials/stat-card', { label: 'Resolved', value: counts.resolved || 0, hint: 'Action taken or settled', icon: 'bi-check2-circle', tone: 'green' }) %></div>
  <div class="col-6 col-md-4"><%- include('partials/stat-card', { label: 'Dismissed', value: counts.dismissed || 0, hint: 'No violation found', icon: 'bi-x-circle', tone: 'blue' }) %></div>
</div>

<%- include('partials/filter-toolbar', {
  formId: 'reportFilter',
  action: '/admin/reports',
  hideSubmit: true,
  toolbarClass: 'filter-bar mb-3',
  fields: [
    { type: 'search', name: 'q', label: 'Search', value: filters.q, placeholder: 'Plate, reporter or description', attrs: { 'data-autosubmit': '' } },
    { type: 'select', name: 'status', label: 'Status', value: filters.status, options: statusOptions, attrs: { 'data-autosubmit': '' } }
  ]
}) %>

<%- include('partials/data-table', {
  caption: 'Parking etiquette reports',
  columns: [{ label: 'Report' }, { label: 'Plate' }, { label: 'Violation' }, { label: 'Incident' }, { label: 'Reported by' }, { label: 'Status' }],
  rows: rows,
  rowPartial: 'partials/rows/admin-report-row',
  pager: pager,
  baseQuery: baseQuery,
  noun: 'reports',
  empty: { icon: 'bi-flag', title: 'No reports found', text: 'Reports that drivers submit appear here.' }
}) %>
