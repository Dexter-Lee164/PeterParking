# Copy to .env (or run `npm run setup`, which creates .env with a random secret).
NODE_ENV=development
PORT=3000

# SQLite database file (relative to the project root).
DB_PATH=data/parking.db

# REQUIRED in production: a long random string (32+ characters).
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Set to true only when the app is served over HTTPS.
SESSION_COOKIE_SECURE=false

# Campus time zone as a fixed UTC offset in minutes (Philippines = +480, no DST).
TZ_OFFSET_MINUTES=480

# Login rate limit: attempts per window per IP.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Development seed accounts (used by `npm run db:seed`). Change before any real use.
SEED_ADMIN_EMAIL=admin@university.test
# Quote values that contain # (an unquoted # starts a comment in .env files).
SEED_ADMIN_PASSWORD="Admin#12345"
SEED_DRIVER_PASSWORD="Driver#12345"

# bcrypt cost factor
BCRYPT_ROUNDS=10
