# University Parking — environment configuration.
# Copy this file to ".env" and adjust. Never commit ".env" (it is listed in .gitignore). No real secrets belong in this example file.
#   PowerShell:  Copy-Item .env.example .env

# ---- Server -------------------------------------------------------------
PORT=3000
# 127.0.0.1 = this computer only. Use 0.0.0.0 to reach the app from other devices on the network.
HOST=127.0.0.1
# development | production | test
NODE_ENV=development

# ---- Public address (links in e-mails) ----------------------------------
# The address people type to reach the site. Every link in an e-mail (password reset, ...) is built from this
# value, never from the request's Host header. No trailing path.
# Production: required, and it must start with https://. Use 127.0.0.1 or localhost consistently (do not mix them).
APP_BASE_URL=http://127.0.0.1:3000

# ---- Campus time --------------------------------------------------------
# All bookings are interpreted in this IANA time zone (fixed UTC offset assumed, e.g. Asia/Manila = UTC+8).
APP_TIMEZONE=Asia/Manila

# ---- Database (SQLite is the only database) -----------------------------
# Relative paths are resolved from the project folder. The file and its -wal/-shm companions are created automatically.
DATABASE_PATH=data/parking.sqlite

# ---- Sessions & cookies -------------------------------------------------
# REQUIRED when NODE_ENV=production (at least 16 characters; 32+ random bytes recommended). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In development, if left empty a random secret is generated at start-up, which signs everyone out after a restart.
SESSION_SECRET= 18c6e7c471950a7a91c0f6597b23aaf50cb6d19f09ef142641809d19d7fe04a5
SESSION_MAX_AGE_HOURS=8
# Set to true when the site is served over HTTPS (marks the session cookie "Secure").
COOKIE_SECURE=false
# Set to true when running behind a reverse proxy that terminates HTTPS (nginx, Caddy, ...).
TRUST_PROXY=false

# ---- Verification codes -------------------------------------------------
# Secret that signs the 6-digit sign-up codes before they are stored (HMAC-SHA256), so a copy of the database alone
# cannot reveal them. REQUIRED in production (at least 32 characters); generate it the same way as SESSION_SECRET.
# In development, if left empty it is derived from SESSION_SECRET or generated randomly for each start.
AUTH_CODE_SECRET= eec89cfeeacba46363410839e8486c9f17bfe79a1e61af2a9dd22f4ac3d722e9

# ---- E-mail address checks ----------------------------------------------
# true = at sign-up, ask DNS whether the address's domain can receive mail (3 s limit; a slow or failing lookup never
# blocks anyone). false = skip that lookup (offline machines, tests).
EMAIL_DNS_CHECK=true

# ---- Outgoing e-mail ----------------------------------------------------
# console = print each message in this terminal and send nothing (development only; the app refuses to start with
#           console mode when NODE_ENV=production).
# smtp    = send through the SMTP server below.
# brevo   = send through Brevo's HTTPS API (BREVO_API_KEY + MAIL_FROM). Use this on hosts that block SMTP ports,
#           such as Railway's Free/Trial/Hobby plans.
MAIL_MODE=brevo
# Brevo API key (Brevo > SMTP & API > API keys; starts with xkeysib-). Only for MAIL_MODE=brevo. Keep it only in .env.
BREVO_API_KEY= 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
# SMTP server name. Gmail: smtp.gmail.com
SMTP_HOST= 
# 587 = STARTTLS (recommended; the connection is refused unless it is encrypted), 465 = TLS from the first byte.
SMTP_PORT=587
# SMTP login. Gmail: the full Gmail address.
SMTP_USER=
# SMTP password. Gmail: a 16-character App Password, NOT your normal password. Keep it only in .env.
SMTP_PASS=
# The "From" line, e.g. University Parking <you@gmail.com>. Gmail rewrites it to the signed-in account anyway.
# With MAIL_MODE=brevo it must be a sender you verified in Brevo.
MAIL_FROM= University Parking <dexterhollon6@gmail.com>
#
# Using a Gmail account (fine for a demo or a few messages a day, not for a production service):
#   1. Turn on 2-Step Verification for the Google account (myaccount.google.com > Security).
#   2. Create an App Password (myaccount.google.com > Security > 2-Step Verification > App passwords).
#   3. MAIL_MODE=smtp  SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=<the address>  SMTP_PASS=<the App Password>
#      MAIL_FROM="University Parking <the address>"
# For real traffic use a transactional provider (an SMTP relay with your own domain and SPF/DKIM).

# ---- Sign-in rate limiting ----------------------------------------------
LOGIN_RATE_WINDOW_MINUTES=15
LOGIN_RATE_MAX_ATTEMPTS=10

# ---- First-run data -----------------------------------------------------
# When the database is empty on first start:
#   SEED_DEMO_DATA=true  -> loads demo zones, slots, drivers and history (development credentials are in the README).
#                           Defaults to true in development and false in production.
#   SEED_DEMO_DATA=false -> creates a single administrator from ADMIN_EMAIL / ADMIN_PASSWORD (below), if both are set.
SEED_DEMO_DATA=true
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Tuning -------------------------------------------------------------
# bcrypt cost factor for password hashing (10-12 is typical; tests use 4).
BCRYPT_ROUNDS=10
# How often (seconds) overdue bookings are closed as no-shows.
NO_SHOW_SWEEP_SECONDS=60
